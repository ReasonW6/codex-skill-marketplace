{
  "manifest_version": 2,
  "name": "Zen Browser Bridge for Codex",
  "version": "0.3.0",
  "description": "Work in real Zen tabs, watch AI operations, and pause or take over through visible page controls.",
  "homepage_url": "https://github.com/ReasonW6/codex-skill-marketplace/tree/main/plugins/zen-browser",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-browser@reasonw6.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"], "optional": [] }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "tabGroups", "storage", "webNavigation", "<all_urls>"],
  "incognito": "not_allowed",
  "background": { "scripts": ["control-state.js", "background.js"], "persistent": true },
  "browser_action": {
    "default_title": "Zen Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
