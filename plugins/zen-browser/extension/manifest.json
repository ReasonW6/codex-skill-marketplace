{
  "manifest_version": 2,
  "name": "Zen Browser Bridge for Codex",
  "version": "0.1.0",
  "description": "Control explicitly selected background tabs in Zen through a local Codex MCP bridge.",
  "homepage_url": "https://github.com/ReasonW6/codex-skill-marketplace/tree/main/plugins/zen-browser",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-browser@reasonw6.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"], "optional": [] }
    }
  },
  "permissions": ["nativeMessaging", "tabs", "storage", "webNavigation", "<all_urls>"],
  "incognito": "not_allowed",
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": {
    "default_title": "Zen Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "content_security_policy": "script-src 'self'; object-src 'none'"
}
